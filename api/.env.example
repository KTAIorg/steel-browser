# Server configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Use DOMAIN if you want to specify a full domain name instead of HOST:PORT
# DOMAIN=example.com

# Set to true to use HTTPS/WSS instead of HTTP/WS
USE_SSL=false

# Chrome/CDP configuration
CHROME_HEADLESS=true
CHROME_EXECUTABLE_PATH=
CHROME_ARGS=
CDP_REDIRECT_PORT=9223
# CDP_DOMAIN=example.com:9223
# KT fork: token for the 9223 CDP gateway (header `x-cdp-token` or `?token=`).
# REQUIRED for any multi-tenant or network-reachable deployment: without it the
# gateway refuses to start, because /devtools/browser lets any caller enumerate
# and attach to every target in this Chrome process (cookies and logged-in
# state included). Keep the value in KTSecret - never commit it.
CDP_TOKEN=
# KT fork: single-tenant escape hatch, enabled here because this template is for
# local development. When CDP_TOKEN is empty it lets the gateway serve
# unauthenticated CDP on 127.0.0.1 ONLY (a published `-p 9223:9223` mapping then
# stops working). Do NOT carry this into production - unset it and set
# CDP_TOKEN instead.
CDP_ALLOW_ANONYMOUS=true
# KT fork: bind Chrome's own remote-debugging socket to 127.0.0.1 instead of
# HOST. Default true - Chrome's endpoint is unauthenticated and unfiltered, so
# exposing it bypasses the gateway entirely. Set false only for compatibility.
# CDP_ALLOW_LOOPBACK_ONLY=true

# Optional proxy configuration
PROXY_URL=

# Logging
LOG_LEVEL=warn # fatal, error, warn, info, debug, trace
ENABLE_CDP_LOGGING=false
LOG_CUSTOM_EMIT_EVENTS=false
ENABLE_VERBOSE_LOGGING=false

# Other configuration options
SKIP_FINGERPRINT_INJECTION=false
DEFAULT_TIMEZONE=
DEFAULT_HEADERS=
